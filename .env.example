# Copy this file to .env and fill in the REQUIRED values before running `docker compose up`.
# docker compose reads .env automatically from this directory. `docker compose up` FAILS FAST
# (with a clear message) for every required variable left unset - there are deliberately no
# insecure built-in default credentials in this stack.

# --- LLM provider -----------------------------------------------------------
# The application is fully provider-agnostic: it only ever calls an OpenAI-compatible
# "/v1/chat/completions" endpoint. By default this stack routes through a local LiteLLM
# proxy (service "litellm"), which in turn talks to a local Ollama instance (service
# "ollama") - see litellm-config.yaml to point it at a different backend/model.
OPENAI_BASE_URL=http://litellm:4000/v1
# REQUIRED. The LiteLLM admin key, used ONLY by the litellm-keygen one-shot job to provision a
# scoped virtual key (model allowlist + budget cap). The application itself never sees this key.
# Generate one, e.g.:  openssl rand -hex 24
LITELLM_MASTER_KEY=

# Optional. Only set OPENAI_API_KEY when OPENAI_BASE_URL points at an external provider instead
# of the bundled LiteLLM. When unset and routing through LiteLLM, the agent container reads the
# scoped virtual key generated by litellm-keygen from /keys/openai_api_key automatically.
# OPENAI_API_KEY=

# Model pulled into the local Ollama container on first start - must match the
# "litellm_params.model" backend in litellm-config.yaml (without the "ollama/" prefix).
OLLAMA_MODEL=llama3.1

# --- This application's own auth/rate limiting ------------------------------
# REQUIRED. Bearer key gating /functions/* and workflow endpoints. The %prod profile (which the
# container image runs) refuses to start without it. Generate one, e.g.:  openssl rand -hex 24
UTILITY_API_KEY=

# Global request-rate cap (requests/minute, 0 = disabled). Defaults to 600 in the %prod profile.
UTILITY_RATE_LIMIT_REQUESTS_PER_MINUTE=600

# --- PostgreSQL (SonataFlow workflow state persistence) ---------------------
# REQUIRED. Choose a strong password. The same value is used for the app's datasource and for
# the separate litellm_db database that LiteLLM uses for virtual-key management.
POSTGRES_PASSWORD=
POSTGRES_USER=openworkflow

# --- Redis (agent short-term memory & cache) --------------------------------
# REQUIRED. Redis runs with --requirepass. Avoid "@", ":", "/" and "?" in the password - it is
# embedded in the redis:// connection URL.
REDIS_PASSWORD=
