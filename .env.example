# Copy this file to .env and adjust values before running `docker compose up`.
# docker compose reads .env automatically from this directory.

# --- LLM provider -----------------------------------------------------------
# The application is fully provider-agnostic: it only ever calls an OpenAI-compatible
# "/v1/chat/completions" endpoint. By default this stack routes through a local LiteLLM
# proxy (service "litellm"), which in turn talks to a local Ollama instance (service
# "ollama") - see litellm-config.yaml to point it at a different backend/model.
OPENAI_BASE_URL=http://litellm:4000/v1
# Without its own database, LiteLLM only accepts its own master key as a bearer token (any
# other value fails with "No connected db"/401) - so by default OPENAI_API_KEY and
# LITELLM_MASTER_KEY must be the same value. Give LiteLLM a Postgres-backed virtual key store
# (see LiteLLM's docs) if you want per-caller keys instead of sharing the master key.
OPENAI_API_KEY=sk-litellm-local-dev
LITELLM_MASTER_KEY=sk-litellm-local-dev

# Model pulled into the local Ollama container on first start - must match the
# "litellm_params.model" backend in litellm-config.yaml (without the "ollama/" prefix).
OLLAMA_MODEL=llama3.1

# --- This application's own auth/rate limiting ------------------------------
# Optional bearer key gating /functions/* and workflow endpoints. Leave blank to keep
# them open (default demo behavior) - see README "Securing the endpoints".
UTILITY_API_KEY=

# Optional global request-rate cap (requests/minute across all endpoints, 0 = disabled).
UTILITY_RATE_LIMIT_REQUESTS_PER_MINUTE=0

# --- PostgreSQL (SonataFlow workflow state persistence) --------------------
POSTGRES_USER=openworkflow
POSTGRES_PASSWORD=openworkflow_secret
